{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // The ocr.test.ts suite runs under `node --experimental-strip-types`, which
    // requires relative imports to carry their .ts extension. Safe here because
    // Expo's base config is noEmit — tsc only ever typechecks this project.
    "allowImportingTsExtensions": true,
    // Pin the ambient @types to what we actually use: "node" for node:test /
    // node:assert (the ocr suite), "jest" for describe/expect (the Jest
    // suites), "react" for JSX. Without this, expo/tsconfig.base doesn't
    // auto-include ambient @types packages, so none of the above resolve.
    "types": ["node", "jest", "react"]
  }
}
